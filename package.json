    "@types/node": "^20.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.0"
  }
}
