  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:evidence": "playwright test --trace on",
    "codegen": "playwright codegen ${BASE_URL:-https://review-chore-qa-i-lgtytk.dev.glopros.com}",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
